{% extends "layout.njk" %}{% block content %}{% if saved %}<p class="success" role="status">Operação realizada com sucesso.</p>{% endif %}<div class="toolbar"><p>{{ rows.length }} registro(s) ativo(s)</p><a class="button" href="/{{ m.plural }}/novo">+ Novo cadastro</a></div><div class="card table-wrap"><table><thead><tr><th>ID</th>{% if m.plural=="pacientes" %}<th>Nome</th><th>Nascimento</th><th>Telefone</th>{% else %}<th>Paciente</th><th>Descrição</th><th>Data</th><th>Valor</th>{% endif %}<th>Ações</th></tr></thead><tbody>{% for r in rows %}<tr><td>{{ r.id }}</td>{% if m.plural=="pacientes" %}<td>{{ r.nome }}</td><td>{{ r.datanascimento | datebr }}</td><td>{{ r.telefone or '—' }}</td>{% else %}<td>{{ r.pacientenome }}</td><td>{{ r.descricao }}</td><td>{{ r.dataconsulta | datebr }}</td><td>{{ r.valor | money }}</td>{% endif %}<td><div class="actions"><a href="/{{ m.plural }}/{{ r.id }}">Consultar</a><a href="/{{ m.plural }}/{{ r.id }}/editar">Editar</a><form action="/{{ m.plural }}/{{ r.id }}/remover" method="post" data-confirm="Remover este registro da listagem ativa?"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="danger">Remover</button></form></div></td></tr>{% else %}<tr><td colspan="6" class="empty">Nenhum registro ativo. Use Novo cadastro para começar.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}