{% extends "layout.njk" %}{% block content %}<section class="card"><dl><dt>ID</dt><dd>{{ record.id }}</dd>{% for f in m.fields %}<dt>{{ f.label }}</dt><dd>{% if f.type=="date" %}{{ record[f.name] | datebr }}{% elif f.name=="valor" %}{{ record.valor | money }}{% elif f.name=="pacienteid" %}{{ record.pacientenome }} · #{{ record.pacienteid }}{% else %}{{ record[f.name] or '—' }}{% endif %}</dd>{% endfor %}<dt>Removido</dt><dd>{{ 'Sim' if record.removido else 'Não' }}</dd></dl><div class="actions"><a class="button" href="/{{ m.plural }}/{{ record.id }}/editar">Editar registro</a><a href="/{{ m.plural }}">Voltar à listagem</a></div></section>{% endblock %}