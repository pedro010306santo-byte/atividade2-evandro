{% extends "layout.njk" %}{% block content %}<form class="card edit-form" action="{{ action }}" method="post"><input type="hidden" name="_csrf" value="{{ csrf }}">{% for f in m.fields %}<div><label for="{{ f.name }}">{{ f.label }}</label>{% if f.type=="select" %}<select id="{{ f.name }}" name="{{ f.name }}" required><option value="">Selecione um paciente</option>{% for p in pacientes %}<option value="{{ p.id }}" {% if record.pacienteid==p.id %}selected{% endif %}>{{ p.nome }} · #{{ p.id }}</option>{% endfor %}</select>{% if not pacientes.length %}<p class="warning">Cadastre um paciente antes de registrar a consulta.</p>{% endif %}{% else %}<input id="{{ f.name }}" name="{{ f.name }}" type="{{ f.type }}" value="{{ record[f.name] or '' }}" {% if f.max %}maxlength="{{ f.max }}"{% endif %} {% if not f.optional %}required{% endif %} {% if f.type=="number" %}min="0" max="99999999.99" step="0.01"{% endif %} {% if f.type=="date" %}min="1900-01-01" max="2199-12-31"{% endif %}>{% endif %}</div>{% endfor %}<div class="form-actions"><button>Salvar cadastro</button><a href="/{{ m.plural }}">Cancelar</a></div></form><p class="hint">Use somente dados fictícios. Os campos obrigatórios também são validados pela API.</p>{% endblock %}